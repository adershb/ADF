{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adbadf11"
		},
		"LS_SINK_ADLS2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_SINK_ADLS2'"
		},
		"LS_SQL_SOURCE_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_SOURCE'"
		},
		"LS_SINK_ADLS2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adbadf11.dfs.core.windows.net/"
		},
		"LS_SQL_SOURCE_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "LAPTOP-9MO2EC5R"
		},
		"LS_SQL_SOURCE_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorks2022"
		},
		"LS_SQL_SOURCE_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adbadf11_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SINK_ADLS2_accountKey": {
						"value": "[parameters('LS_SINK_ADLS2_accountKey')]"
					},
					"LS_SQL_SOURCE_password": {
						"value": "[parameters('LS_SQL_SOURCE_password')]"
					},
					"LS_SINK_ADLS2_properties_typeProperties_url": {
						"value": "[parameters('LS_SINK_ADLS2_properties_typeProperties_url')]"
					},
					"LS_SQL_SOURCE_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_SOURCE_properties_typeProperties_server')]"
					},
					"LS_SQL_SOURCE_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_SOURCE_properties_typeProperties_database')]"
					},
					"LS_SQL_SOURCE_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_SOURCE_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}